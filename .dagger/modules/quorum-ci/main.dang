"""
The Dagger arm's CI for Quorum Run: one Check, `test`, which runs ci/check.sh
(the acceptance suite with the integrity bar: tests/ intact, all 333 tests
ran, every src/ module parses) in the same node image the agents use.
"""
type QuorumCi {
  """
  Run the acceptance suite with ci/check.sh and print the score.
  """
  pub test(ws: Workspace!): Void @check {
    container
      .from("node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205")
      .withWorkdir("/w")
      .withDirectory("/w", ws.directory(".", include: ["ci/**", "src/**", "tests/**", "index.html", "package.json", "DESIGN.md"]))
      .withExec(["sh", "ci/check.sh"])
      .sync
    null
  }
}
